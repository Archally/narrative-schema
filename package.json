{
  "name": "@archally/narrative-schema",
  "version": "1.5.0",
  "description": "YAML format and conformance tools for narrative models",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Adam Walkowski",
  "repository": {
    "type": "git",
    "url": "https://github.com/Archally/narrative-schema.git"
  },
  "homepage": "https://narrative.archally.pro",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./schema/v1.5/*": "./schema/v1.5/*"
  },
  "files": [
    "schema/",
    "tools/",
    "docs/",
    "examples/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-FSL",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "validate": "node tools/validator/cli.mjs --schemas schema/v1.5",
    "validate:example": "npm run validate -- --model examples/public-deck",
    "port:verify": "node tools/port/verify-ported.mjs",
    "release:check": "node tools/port/release-check.mjs --expect 1.5.0",
    "test": "node --test tools/port/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
