{
  "name": "@archally/narrative-schema",
  "version": "1.7.0",
  "description": "YAML format and conformance tools for narrative models",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Adam Walkowski",
  "repository": {
    "type": "git",
    "url": "https://github.com/Archally/narrative-schema.git"
  },
  "homepage": "https://narrative.archally.pro",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./schema/v1.7/*": "./schema/v1.7/*"
  },
  "files": [
    "schema/",
    "tools/",
    "docs/",
    "examples/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-FSL",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "validate": "node tools/validator/cli.mjs --schemas schema/v1.7",
    "validate:example": "npm run validate -- --model examples/public-deck",
    "build:model": "node tools/model-builder/cli.mjs",
    "next-id": "node tools/next-id/cli.mjs",
    "check:semantic": "node tools/semantic-checker/cli.mjs",
    "check:semantic:example": "npm run check:semantic -- examples/public-deck --strict",
    "port:verify": "node tools/port/verify-ported.mjs",
    "release:check": "node tools/port/release-check.mjs --expect 1.7.0",
    "test": "node --test tools/port/*.test.mjs tools/validator/*.test.mjs tools/model-builder/*.test.mjs tools/next-id/*.test.mjs tools/semantic-checker/*.test.mjs"
  },
  "dependencies": {
    "@archally/semantic-checker": "git+https://github.com/archally/semantic-checker.git#v0.1.1",
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
